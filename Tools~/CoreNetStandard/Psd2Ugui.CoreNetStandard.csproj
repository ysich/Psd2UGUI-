<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unity 2021.3 / 2022.3 的脚本运行时等价于 .NET Standard 2.1；
         这里把 Core 单独按同一目标编译一遍，用来提前发现 Unity 里编译不过的 API。 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Psd2Ugui.Core.CompatCheck</AssemblyName>
    <RootNamespace>Psd2Ugui.Core</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/Core/**/*.cs" LinkBase="CoreSource" />
  </ItemGroup>

</Project>
